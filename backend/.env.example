# --- Precedent AI backend configuration (copy to .env and fill in) ---
# Never commit a real .env. Secrets stay local / in Key Vault.

# mock = serve ZebraAI responses from fixtures/zebraai/*.json (default, offline)
# live = call the ZebraAI MCP server (requires approved experiments + auth)
ZEBRAAI_MODE=mock

# Optional override; defaults to <repo>/fixtures/zebraai
# FIXTURES_DIR=

# --- Azure OpenAI (the agent's GPT reasoning brain) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-gpt-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# --- ZebraAI MCP server (only needed when ZEBRAAI_MODE=live) ---
# Grounded in ZebraAI-Wiki/How-To-Guides/Using-ZebraAI-MCP-Server.md
ZEBRAAI_MCP_URL=https://zebra-ai-api-prd.ait.microsoft.com/mcp
ZEBRAAI_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
ZEBRAAI_RESOURCE_ID=9021b3a5-1f0d-4fb7-ad3f-d6989f0432d8
# Approved experiment GUIDs (friendly names are not supported by the MCP tool)
ZEBRAAI_EXPERIMENT_CASE_KM_ID=
ZEBRAAI_EXPERIMENT_CASE_ICM_ID=

# --- API / agent behavior ---
# Comma-separated origins allowed by CORS (Vite dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Max self-check retry loops before emitting an honest low-confidence answer
SELF_CHECK_MAX_RETRIES=1
